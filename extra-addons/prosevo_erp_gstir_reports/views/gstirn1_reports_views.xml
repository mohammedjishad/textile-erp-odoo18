<odoo>
    <data>
        <!-- Custom Tax Report Form without New, Save, and Discard buttons  -->
        <record id="view_gstirn1_report_form" model="ir.ui.view">
            <field name="name">gstirn1.report.form</field>
            <field name="model">gstirn1.report</field>
            <field name="arch" type="xml">
                <form string="Custom Model Report">
                    <h2 style="font-size:28px">
                        <b>GSTIRN1 Reports</b>
                    </h2>
                    <div class="row" style="margin:auto;padding:20px; width:100%; border:1px solid black;height:150px">

                        <div class="col">
                            <group>
                                <field name="start_date" string="From" class="oe_inline" widget="date"
                                       style="margin-right: 10px; border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                            </group>
                        </div>
                        <div class="col">
                            <group>
                                <field name="end_date" string="To" class="oe_inline" widget="date"
                                       style="margin-right: 10px;border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                            </group>
                        </div>
                        <div class="col">
                            <group>
                                <field name="warehouse_id" string="Branch"
                                       style="margin-right: 10px;border: 1px solid #ccc; padding: 5px; border-radius: 4px;"
                                       options='{"no_open": True,"no_create_edit":True, "no_create": True}'/>
                            </group>
                        </div>
                        <div class="col">
                            <group>
                                <field name="type" string="Type"
                                       style="margin-right: 10px;border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                            </group>
                        </div>

                        <div class="col" style="display: inline-block;vertical-align: top; margin-top: -4px; width: 300px; height: 68px; overflow-y: auto; padding: 5px;"
                             invisible="type != 'hsn'">
                            <group>
                                <field name="hsn_type" string="HSN Type" invisible="type != 'hsn'"  style="margin-right: 10px;border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                            </group>
                        </div>

                        <div style="display:flex;gap: 15px;">
                            <button name="generate_report" string="GET REPORT" type="object"
                                    class="btn-primary oe_inline"
                                    style="border-radius: 30px;cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2); box-shadow: 0 0 5px rgba(0, 0, 0, 0.4); "/>
                            <button name="generate_excel_report" string="Excel" type="object" class="btn-primary"
                                    style="border-radius: 30px; cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2); box-shadow: 0 0 5px rgba(0, 0, 0, 0.4);"/>
                            <button name="generate_pdf_report" string="PDF" type="object" class="btn-primary"
                                    style="border-radius: 30px; cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2); box-shadow: 0 0 5px rgba(0, 0, 0, 0.4);"/>

                        </div>
                    </div>
                    <!--                     <hr style="border-top: 1px solid #A9A9A9"/> -->
                    <field name="report_data" nolabel="1" widget="html" readonly="1" invisible="not report_data"/>
                </form>
            </field>
        </record>
        <!--  Action to open the Tax Report form  -->
        <record id="action_gstirn1_report" model="ir.actions.act_window">
            <field name="name">GSTIRN1 Reports</field>
            <field name="res_model">gstirn1.report</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>
    </data>
</odoo>