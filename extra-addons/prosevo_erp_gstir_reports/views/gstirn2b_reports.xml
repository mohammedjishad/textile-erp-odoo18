<odoo>
    <data>
        <!--Custom Tax Report Form without New, Save, and Discard buttons -->
        <record id="view_gstirn2b_report_form" model="ir.ui.view">
            <field name="name">gstirn2b.report.form</field>
            <field name="model">gstirn2b.report</field>
            <field name="arch" type="xml">
                <form string="Custom GSTIRN2B Report">
                    <h2 style="font-size:28px">
                        <b>GSTIRN2B Reports</b>
                    </h2>
                    <div class="row" style="margin:auto;padding:20px; width:100%; border:1px solid black;height:150px">
                        <div class="col">
                            <group>
                                <field name="start_date" string="From"
                                       style="margin-right: 10px; border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                            </group>
                        </div>
                        <div class="col">
                            <group>
                                <field name="end_date" string="To"
                                       style="margin-right: 10px; border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                            </group>
                        </div>


                        <div class="col">
                            <group>
                                <field name="warehouse_id"
                                       options='{"no_open": True,"no_create_edit":True, "no_create": True}'
                                       style="margin-right: 10px; border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                            </group>
                        </div>

                        <div style="display:flex;gap: 15px;">
                            <button name="generate_report" string="GET REPORT" type="object"
                                    class="btn-primary oe_inline"
                                    style="border-radius: 30px;cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                                       box-shadow: 0 0 5px rgba(0, 0, 0, 0.4); "/>
                            <button name="generate_pdf_report" string="Pdf" type="object" class="btn-primary"
                                    style="border-radius: 30px;cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                                       box-shadow: 0 0 5px rgba(0, 0, 0, 0.4);"/>
                            <button name="generate_xlsx_report_gstrin2b" string="Excel" type="object"
                                    class="btn-primary"
                                    style="border-radius: 30px; cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
               box-shadow: 0 0 5px rgba(0, 0, 0, 0.4);"/>
                        </div>
                    </div>
                    <!--                    <hr style="border-top: 1px solid #A9A9A9"/>-->
                    <div class="row" style="width:100%; margin:auto">
                        <field name="report_data" nolabel="1" widget="html" readonly="1"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action to open the Tax Report form -->
        <record id="action_gstirn2b_report" model="ir.actions.act_window">
            <field name="name">GSTIRN2B Report</field>
            <field name="res_model">gstirn2b.report</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

    </data>
</odoo>