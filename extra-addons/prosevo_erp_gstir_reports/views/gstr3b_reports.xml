<odoo>
    <data>
        <record id="view_gstr3b_report_form" model="ir.ui.view">
            <field name="name">gstr3b.report.form</field>
            <field name="model">gstr3b.report</field>
            <field name="arch" type="xml">
                <form string="GSTR-3B Report">
                    <h2 style="text-align:left;">
                        <b>GSTR-3B Ledger</b>
                    </h2>
                    <div class="row" style="border:1px solid #ccc; margin:auto; padding:20px;">
                        <!-- Date From -->
                        <div style="display: inline-block; width: 22%; margin-right: 2%;">
                            <label for="date_from" string="From" style="display:block; margin-bottom:5px;"/>
                            <field name="date_from" widget="date" style="width: 100%;margin-right: 10px;border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                        </div>

                        <!-- Date To -->
                        <div style="display: inline-block; width: 22%; margin-right: 2%;">
                            <label for="date_to" string="To" style="display:block; margin-bottom:5px;"/>
                            <field name="date_to" widget="date" style="width: 100%;margin-right: 10px;border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                        </div>

                        <!-- Branch -->
                        <div style="display: inline-block; width: 22%; margin-right: 2%;">
                            <label for="warehouse_id" string="Branch" style="display:block; margin-bottom:5px;"/>
                            <field name="warehouse_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" style="width: 100%;margin-right: 10px;border: 1px solid #ccc; padding: 5px; border-radius: 4px;"/>
                        </div>

                        <div style="display: flex; gap: 15px;margin-top: 20px;">
                            <button name="action_generate_report" string="GET REPORT" type="object"
                                    class="btn-primary oe_inline"
                                    style="border-radius: 30px;cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                                       box-shadow: 0 0 5px rgba(0, 0, 0, 0.4); margin-right: 30px;"/>
                            <button name="action_generate_pdf" string="PDF" type="object"
                                    class="btn-primary oe_inline"
                                    style="border-radius: 30px;cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                                       box-shadow: 0 0 5px rgba(0, 0, 0, 0.4); margin-right: 30px;"/>
                            <button name="action_generate_excel" string="Excel" type="object"
                                    class="btn-primary oe_inline"
                                    style="border-radius: 30px;cursor: pointer; color: #FFFFFF; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                                       box-shadow: 0 0 5px rgba(0, 0, 0, 0.4); margin-right: 30px;"/>
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <field name="report_data" widget="html" readonly="1"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action to open the Tax Report form -->
        <record id="action_gstr3b_report" model="ir.actions.act_window">
            <field name="name">GSTRN3B Report</field>
            <field name="res_model">gstr3b.report</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

    </data>
</odoo>