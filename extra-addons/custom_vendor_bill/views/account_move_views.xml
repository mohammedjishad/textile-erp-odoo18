<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         VENDOR BILL FORM VIEW — Inherited & Extended
    ════════════════════════════════════════════════════════════ -->
    <record id="view_custom_vendor_bill_form" model="ir.ui.view">
        <field name="name">custom.vendor.bill.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">

            <!-- ── Shipment Smart Button ── -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_shipments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="move_type != 'in_invoice'">
                    <field name="x_shipment_count" widget="statinfo" string="Shipment"/>
                </button>
            </xpath>

            <!-- ── Custom Header Fields (after partner) ── -->
            <xpath expr="//label[@for='partner_id']"  position="before">
                <field name="x_warehouse_id"
                       invisible="move_type != 'in_invoice'"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//label[@for='partner_id']"  position="after">
                <field name="x_is_tcs_applicable"
                       invisible="move_type != 'in_invoice'"/>
            </xpath>

            <!-- ── Right side header fields ── -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="x_delivery_challan"
                       invisible="move_type != 'in_invoice'"
                       placeholder="Delivery Challan No."/>
                <field name="x_remarks"
                       invisible="move_type != 'in_invoice'"
                       placeholder="Remarks..."/>
                <field name="x_update_cost_on_save"
                       invisible="move_type != 'in_invoice'"/>
            </xpath>

            <!-- ── Invoice Lines: Add Stock, Label, Lot columns ── -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="x_stock_qty" string="Stock" optional="show" readonly="1"/>
                <field name="x_label" string="Label" optional="show"/>
                <field name="x_lot_id" string="Lot" optional="show"
                       domain="[('product_id', '=', product_id)]"
                       options="{'no_create': False}"/>
            </xpath>

            <!-- ── Extra Tabs ── -->
            <xpath expr="//page[@name='invoice_tab']" position="after">

                <!-- Delivery Address Tab -->
                <page string="Delivery Address" name="delivery_address_tab"
                      invisible="move_type != 'in_invoice'">
                    <group>
                        <group string="Delivery To">
                            <field name="x_delivery_partner_id"
                                   string="Select Address"
                                   options="{'no_create': False}"/>
                            <field name="x_delivery_street" placeholder="Street"/>
                            <field name="x_delivery_street2" placeholder="Street 2"/>
                            <field name="x_delivery_city" placeholder="City"/>
                            <field name="x_delivery_state_id" placeholder="State"/>
                            <field name="x_delivery_zip" placeholder="ZIP"/>
                            <field name="x_delivery_country_id" placeholder="Country"/>
                        </group>
                    </group>
                </page>

                <!-- Handling Charges Tab -->
                <page string="Handling Charges" name="handling_charges_tab"
                      invisible="move_type != 'in_invoice'">
                    <group>
                        <group string="Charges Breakdown">
                            <field name="x_freight_charge"/>
                            <field name="x_loading_charge"/>
                            <field name="x_unloading_charge"/>
                            <field name="x_packing_charge"/>
                            <field name="x_other_charge"/>
                            <field name="x_handling_remarks" placeholder="Handling remarks..."/>
                        </group>
                        <group string="Summary">
                            <field name="x_total_handling_charge" readonly="1"/>
                        </group>
                    </group>
                </page>

                <!-- E-Way Bill Details Tab -->
                <page string="E-Way Bill Details" name="eway_bill_tab"
                      invisible="move_type != 'in_invoice'">
                    <group>
                        <group string="E-Way Bill Info">
                            <field name="x_eway_bill_no" placeholder="E-Way Bill Number"/>
                            <field name="x_eway_bill_date"/>
                            <field name="x_eway_valid_upto"/>
                        </group>
                        <group string="Transporter Details">
                            <field name="x_transporter_name" placeholder="Transporter Name"/>
                            <field name="x_transporter_id_no" placeholder="GSTIN / ID"/>
                            <field name="x_transport_doc_no" placeholder="LR / RR No."/>
                            <field name="x_transport_doc_date"/>
                            <field name="x_mode_of_transport"/>
                            <field name="x_approx_distance"/>
                        </group>
                    </group>
                </page>

            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACTION — Fast Purchase Bill (opens vendor bill create form)
    ════════════════════════════════════════════════════════════ -->
    <record id="action_fast_purchase_bill" model="ir.actions.act_window">
        <field name="name">Fast Purchase Bill</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{
            'default_move_type': 'in_invoice',
            'default_journal_id': False,
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_move_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_custom_vendor_bill_form')})
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Fast Purchase Bill
            </p>
            <p>
                Fill in vendor and product details, then post the bill.
                An incoming shipment will be automatically created.
            </p>
        </field>
    </record>

</odoo>
