<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_branch_direct_transfer_tree" model="ir.ui.view">
        <field name="name">branch.direct.transfer.tree</field>
        <field name="model">branch.direct.transfer</field>
        <field name="arch" type="xml">
            <list string="Direct Transfers">
                <field name="name"/>
                <field name="date_transfer"/>
                <field name="transfer_type"/>
                <field name="warehouse_id"/>
                <field name="other_warehouse_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_branch_direct_transfer_form" model="ir.ui.view">
        <field name="name">branch.direct.transfer.form</field>
        <field name="model">branch.direct.transfer</field>
        <field name="arch" type="xml">
            <form string="Direct Transfer">
                <header>
                    <button name="action_save" string="Save" type="object" class="btn-primary" invisible="id"/>
                    <button name="action_done" string="Send" type="object" class="btn-primary" invisible="state != 'draft' or transfer_type != 'send' or not id"/>
                    <button name="action_done" string="Receive" type="object" class="btn-primary" invisible="state != 'draft' or transfer_type != 'receive' or not id"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled') or not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_picking"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not picking_id">
                            <span class="o_stat_text">Operation</span>
                        </button>
                    </div>
                    <field name="picking_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="transfer_type" widget="radio" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="SOURCE WAREHOUSE">
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="DESTINATION WAREHOUSE">
                            <field name="other_warehouse_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Info">
                            <field name="date_transfer" readonly="state != 'draft'"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_branch_direct_transfer" model="ir.actions.act_window">
        <field name="name">Direct Transfers</field>
        <field name="res_model">branch.direct.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Direct Branch Transfer.
            </p>
        </field>
    </record>
</odoo>
