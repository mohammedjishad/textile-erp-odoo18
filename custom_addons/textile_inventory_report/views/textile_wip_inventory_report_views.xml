<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_textile_wip_inventory_report_search" model="ir.ui.view">
        <field name="name">textile.wip.inventory.report.search</field>
        <field name="model">textile.wip.inventory.report</field>
        <field name="arch" type="xml">
            <search string="WIP Inventory Report Search">
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <field name="location_id"/>
                <group expand="1" string="Group By">
                    <filter string="Work Center" name="group_by_workcenter" context="{'group_by':'workcenter_id'}"/>
                    <filter string="WIP Location" name="group_by_location" context="{'group_by':'location_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List (Tree) View -->
    <record id="view_textile_wip_inventory_report_list" model="ir.ui.view">
        <field name="name">textile.wip.inventory.report.list</field>
        <field name="model">textile.wip.inventory.report</field>
        <field name="arch" type="xml">
            <list string="WIP Inventory Report" create="false" edit="false" delete="false">
                <field name="workcenter_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="reserved_quantity" sum="Total Reserved Quantity"/>
                <field name="uom_id"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_textile_wip_inventory_report_pivot" model="ir.ui.view">
        <field name="name">textile.wip.inventory.report.pivot</field>
        <field name="model">textile.wip.inventory.report</field>
        <field name="arch" type="xml">
            <pivot string="WIP Inventory Analysis" disable_linking="True">
                <field name="workcenter_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_textile_wip_inventory_report" model="ir.actions.act_window">
        <field name="name">WIP Inventory Report</field>
        <field name="res_model">textile.wip.inventory.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_textile_wip_inventory_report_search"/>
        <field name="context">{'search_default_group_by_workcenter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No WIP inventory data found.
            </p>
            <p>
                This report shows real-time product quantities currently located at each manufacturing workcenter's WIP location.
            </p>
        </field>
    </record>

    <!-- Menu inside Inventory -> Reporting -->
    <menuitem id="menu_textile_wip_inventory_report_stock"
              name="WIP Inventory Report"
              action="action_textile_wip_inventory_report"
              parent="stock.menu_warehouse_report"
              sequence="20"/>

    <!-- Menu inside Manufacturing -> Reporting -->
    <menuitem id="menu_textile_wip_inventory_report_mrp"
              name="WIP Inventory Report"
              action="action_textile_wip_inventory_report"
              parent="mrp.menu_mrp_reporting"
              sequence="25"/>
</odoo>
