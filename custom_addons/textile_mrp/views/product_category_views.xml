<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_inherit_textile_mrp" model="ir.ui.view">
        <field name="name">product.category.form.inherit.textile.mrp</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="textile_cost_bucket"/>
                <field name="bom_usage_type"/>
            </xpath>
        </field>
    </record>
</odoo>
