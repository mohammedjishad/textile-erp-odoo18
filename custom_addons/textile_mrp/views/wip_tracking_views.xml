<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard View -->
    <record id="view_textile_wip_tracking_wizard_form" model="ir.ui.view">
        <field name="name">textile.wip.tracking.wizard.form</field>
        <field name="model">textile.wip.tracking.wizard</field>
        <field name="arch" type="xml">
            <form string="Record WIP Tracking">
                <group>
                    <field name="action_type" readonly="1" invisible="1"/>
                    <field name="workorder_id" readonly="1" force_save="1"/>
                    <field name="is_multi_variant" invisible="1"/>
                    <field name="qty" required="1" invisible="is_multi_variant"/>
                    <field name="notes"/>
                </group>
                <notebook invisible="not is_multi_variant">
                    <page string="Variant Quantities">
                        <field name="line_ids">
                            <list editable="bottom" create="false" delete="false">
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="qty"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- WIP Log List View -->
    <record id="view_textile_wip_log_tree" model="ir.ui.view">
        <field name="name">textile.wip.log.tree</field>
        <field name="model">textile.wip.log</field>
        <field name="arch" type="xml">
            <list string="WIP Tracking Logs" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="action_type" widget="badge" 
                       decoration-success="action_type == 'produce'" 
                       decoration-info="action_type == 'transfer'"/>
                <field name="qty"/>
                <field name="notes"/>
            </list>
        </field>
    </record>
    
    <!-- Action for WIP Log Menu -->
    <record id="action_textile_wip_log" model="ir.actions.act_window">
        <field name="name">Production History Logs</field>
        <field name="res_model">textile.wip.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tracking logs found.
            </p>
            <p>
                WIP tracking logs will appear here once operators start recording production or transferring pieces.
            </p>
        </field>
    </record>

</odoo>
