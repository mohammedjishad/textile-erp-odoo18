<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_textile_accounting" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.textile.accounting</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Profitability" name="textile_profitability" invisible="parent_id">
                    <group>
                        <group string="Financial Analysis">
                            <field name="sales_revenue" widget="monetary"/>
                            <field name="manufacturing_cost" widget="monetary"/>
                            <field name="profit" widget="monetary" style="font-weight: bold;"/>
                            <field name="margin_percent"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Tree view for Customer Profitability -->
    <record id="res_partner_tree_view_inherit_textile_accounting" model="ir.ui.view">
        <field name="name">res.partner.tree.view.inherit.textile.accounting</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Customer Profitability" create="false" edit="false">
                <field name="name"/>
                <field name="sales_revenue" sum="Total Sales"/>
                <field name="manufacturing_cost" sum="Total Cost"/>
                <field name="profit" sum="Total Profit"/>
                <field name="margin_percent" avg="Average Margin %"/>
            </list>
        </field>
    </record>

    <!-- Action for Customer Profitability -->
    <record id="action_textile_partner_profits" model="ir.actions.act_window">
        <field name="name">Customer Profitability</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="res_partner_tree_view_inherit_textile_accounting"/>
        <field name="domain">[('sales_revenue', '>', 0.0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer profitability statistics found. Confirm sales orders to view customer margins.
            </p>
        </field>
    </record>
</odoo>
