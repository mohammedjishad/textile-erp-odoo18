<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Graph View -->
    <record id="mrp_production_dashboard_graph" model="ir.ui.view">
        <field name="name">mrp.production.dashboard.graph</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <graph string="Manufacturing Profit Analysis" type="bar" sample="1">
                <field name="product_id"/>
                <field name="manufacturing_profit" type="measure"/>
                <field name="total_manufacturing_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard Pivot View -->
    <record id="mrp_production_dashboard_pivot" model="ir.ui.view">
        <field name="name">mrp.production.dashboard.pivot</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Manufacturing Financial Summary" sample="1">
                <field name="product_id" type="row"/>
                <field name="total_manufacturing_cost" type="measure"/>
                <field name="manufacturing_value" type="measure"/>
                <field name="manufacturing_profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_textile_accounting_dashboard" model="ir.actions.act_window">
        <field name="name">Accounting Dashboard</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No manufacturing dashboard data available. Produce garments to see profit charts.
            </p>
        </field>
    </record>

    <!-- Link Graph View to Action -->
    <record id="action_textile_accounting_dashboard_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="mrp_production_dashboard_graph"/>
        <field name="act_window_id" ref="action_textile_accounting_dashboard"/>
    </record>

    <!-- Link Pivot View to Action -->
    <record id="action_textile_accounting_dashboard_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="mrp_production_dashboard_pivot"/>
        <field name="act_window_id" ref="action_textile_accounting_dashboard"/>
    </record>


    <!-- Main Menus -->
    <menuitem id="menu_textile_accounting_root"
              name="Textile Accounting"
              sequence="25"/>

    <menuitem id="menu_textile_accounting_dashboard"
              name="Dashboard"
              parent="menu_textile_accounting_root"
              action="action_textile_accounting_dashboard"
              sequence="10"/>

    <menuitem id="menu_textile_mfg_costs"
              name="Manufacturing Costs"
              parent="menu_textile_accounting_root"
              action="action_textile_mfg_costs"
              sequence="20"/>

    <menuitem id="menu_textile_sales_profits"
              name="Sales Profitability"
              parent="menu_textile_accounting_root"
              action="action_textile_sales_profits"
              sequence="30"/>

    <menuitem id="menu_textile_product_profits"
              name="Product Profitability"
              parent="menu_textile_accounting_root"
              action="action_textile_product_profits"
              sequence="40"/>

    <menuitem id="menu_textile_partner_profits"
              name="Customer Profitability"
              parent="menu_textile_accounting_root"
              action="action_textile_partner_profits"
              sequence="50"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_textile_accounting_config_root"
              name="Configuration"
              parent="menu_textile_accounting_root"
              sequence="100"/>

    <menuitem id="menu_textile_accounting_settings"
              name="Settings"
              parent="menu_textile_accounting_config_root"
              action="action_textile_accounting_config"
              sequence="10"/>

</odoo>
