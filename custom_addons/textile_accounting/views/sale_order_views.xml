<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_textile_accounting" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.textile.accounting</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Profitability" name="textile_profitability">
                    <group>
                        <group string="Sales Margins">
                            <field name="amount_untaxed" widget="monetary"/>
                            <field name="manufacturing_cost" widget="monetary"/>
                            <div class="o_td_label">
                                <label for="gross_profit" style="font-weight: bold;"/>
                            </div>
                            <field name="gross_profit" nolabel="1" widget="monetary" style="font-weight: bold;"/>
                            <field name="margin_percent"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='price_subtotal']" position="after">
                <field name="manufacturing_cost" optional="hide"/>
                <field name="gross_profit" optional="show"/>
                <field name="margin_percent" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Tree view for Sale Order Profitability -->
    <record id="sale_order_tree_view_inherit_textile_accounting" model="ir.ui.view">
        <field name="name">sale.order.tree.view.inherit.textile.accounting</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Sales Profits" create="false" edit="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="amount_untaxed" sum="Total Sales"/>
                <field name="manufacturing_cost" sum="Total Cost"/>
                <field name="gross_profit" sum="Total Profit"/>
                <field name="margin_percent" avg="Average Margin %"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action for Sales Profitability -->
    <record id="action_textile_sales_profits" model="ir.actions.act_window">
        <field name="name">Sales Profitability</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale_order_tree_view_inherit_textile_accounting"/>
        <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sales profit records found. Confirm sales orders to view profitability.
            </p>
        </field>
    </record>
</odoo>
