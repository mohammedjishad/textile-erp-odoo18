<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_textile_accounting" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.textile.accounting</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Textile Traceability" name="textile_traceability">
                    <group>
                        <group string="Origin Details">
                            <field name="textile_mo_id" readonly="1"/>
                            <field name="textile_sale_order_id" readonly="1"/>
                            <field name="textile_customer_id" readonly="1"/>
                            <field name="textile_production_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Related Documents">
                            <field name="textile_invoice_ids" widget="many2many_tags" readonly="1"/>
                            <field name="textile_delivery_picking_ids" widget="many2many_tags" readonly="1"/>
                            <field name="textile_quality_inspection_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
