<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_inventory_document">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2>Inventory Report</h2>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Product</th>
                                <th class="text-right">Unit Cost</th>
                                <th class="text-right">On Hand</th>
                                <th class="text-right">Total Value</th>
                                <th class="text-right">Gross Profit</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="product">
                                <tr>
                                    <td><span t-field="product.x_category_name"/></td>
                                    <td><span t-field="product.name"/></td>
                                    <td class="text-right"><span t-field="product.x_unit_cost"/></td>
                                    <td class="text-right"><span t-field="product.x_qty_on_hand"/></td>
                                    <td class="text-right"><span t-field="product.x_total_value"/></td>
                                    <td class="text-right"><span t-field="product.x_gross_profit"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
