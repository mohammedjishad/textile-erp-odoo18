<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="production_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-6">
                                <span t-field="doc.company_id.logo" t-options="{'widget': 'image', 'style': 'max-height: 45px;'}"/>
                            </div>
                            <div class="col-6 text-end">
                                <h3>Production Order Report</h3>
                                <h4><span t-field="doc.name"/></h4>
                            </div>
                        </div>

                        <hr/>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Product:</strong> <span t-field="doc.product_id.display_name"/><br/>
                                <strong>Origin SO:</strong> <span t-field="doc.origin"/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Scheduled Date:</strong> <span t-field="doc.date_start" t-options='{"widget": "date"}'/><br/>
                                <strong>Responsible:</strong> <span t-field="doc.user_id.name"/><br/>
                            </div>
                        </div>

                        <h4>Consumption &amp; Performance</h4>
                        <table class="table table-bordered mb-4">
                            <thead>
                                <tr>
                                    <th>Planned Qty</th>
                                    <th>Produced Qty</th>
                                    <th>Issued Fabric (m)</th>
                                    <th>Consumed Fabric (m)</th>
                                    <th>Returned Fabric (m)</th>
                                    <th>Waste Qty</th>
                                    <th>Waste %</th>
                                    <th>Efficiency %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="doc.product_qty"/></td>
                                    <td><span t-field="doc.qty_produced"/></td>
                                    <td><span t-field="doc.issued_fabric"/></td>
                                    <td><span t-field="doc.consumed_fabric"/></td>
                                    <td><span t-field="doc.returned_fabric"/></td>
                                    <td><span t-field="doc.waste_qty"/></td>
                                    <td><span t-field="doc.waste_pct" t-options='{"widget": "float", "precision": 2}'/>%</td>
                                    <td><span t-field="doc.efficiency" t-options='{"widget": "float", "precision": 2}'/>%</td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Textile Costing</h4>
                        <table class="table table-bordered mb-4">
                            <thead>
                                <tr>
                                    <th>Fabric Cost</th>
                                    <th>Thread Cost</th>
                                    <th>Accessories</th>
                                    <th>Labor</th>
                                    <th>Machine</th>
                                    <th>Packaging</th>
                                    <th>Overhead</th>
                                    <th>Total Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="doc.fabric_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></td>
                                    <td><span t-field="doc.thread_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></td>
                                    <td><span t-field="doc.accessories_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></td>
                                    <td><span t-field="doc.labor_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></td>
                                    <td><span t-field="doc.machine_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></td>
                                    <td><span t-field="doc.packaging_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></td>
                                    <td><span t-field="doc.overhead_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></td>
                                    <td><strong><span t-field="doc.total_textile_cost" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/></strong></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="doc.workorder_ids">
                            <h4>Work Orders</h4>
                            <table class="table table-striped mb-4">
                                <thead>
                                    <tr>
                                        <th>Work Center</th>
                                        <th>Operation</th>
                                        <th>State</th>
                                        <th class="text-end">Duration (min)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.workorder_ids" t-as="wo">
                                        <td><span t-field="wo.workcenter_id.name"/></td>
                                        <td><span t-field="wo.name"/></td>
                                        <td><span t-field="wo.state"/></td>
                                        <td class="text-end"><span t-field="wo.duration" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.move_raw_ids">
                            <h4>Raw Materials</h4>
                            <table class="table table-striped mb-4">
                                <thead>
                                    <tr>
                                        <th>Component</th>
                                        <th class="text-end">Planned Qty</th>
                                        <th class="text-end">Done Qty</th>
                                        <th>UoM</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.move_raw_ids" t-as="move">
                                        <td><span t-field="move.product_id.name"/></td>
                                        <td class="text-end"><span t-field="move.product_uom_qty"/></td>
                                        <td class="text-end"><span t-field="move.quantity"/></td>
                                        <td><span t-field="move.product_uom"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div class="footer o_standard_footer mt-4">
                            <div class="text-center" style="border-top: 1px solid black;">
                                <div class="text-muted">
                                    Page: <span class="page"/> / <span class="topage"/> | Printed Date: <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d')"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
