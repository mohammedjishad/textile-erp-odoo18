<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_textile" model="ir.module.category">
        <field name="name">Textile</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_textile_sales_user" model="res.groups">
        <field name="name">Sales User</field>
        <field name="category_id" ref="module_category_textile"/>
    </record>

    <record id="group_textile_production_user" model="res.groups">
        <field name="name">Production User</field>
        <field name="category_id" ref="module_category_textile"/>
    </record>

    <record id="group_textile_quality_user" model="res.groups">
        <field name="name">Quality User</field>
        <field name="category_id" ref="module_category_textile"/>
    </record>

    <record id="group_textile_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_sales_user')), (4, ref('group_textile_production_user')), (4, ref('group_textile_quality_user'))]"/>
    </record>

    <record id="group_textile_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_manager'))]"/>
    </record>
</odoo>
