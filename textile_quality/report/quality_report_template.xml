<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="quality_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.production_id.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h3>Quality Inspection Report</h3>
                            <h4>Checkpoint: <span t-field="o.checkpoint"/></h4>
                        </div>

                        <hr/>

                        <div class="row mb-4">
                            <div class="col-6">
                                <h5>Production Details</h5>
                                <strong>MO Number:</strong> <span t-field="o.production_id.name"/><br/>
                                <strong>Product:</strong> <span t-field="o.production_id.product_id.name"/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <h5>Inspection Info</h5>
                                <strong>Inspector:</strong> <span t-field="o.inspector_id.name"/><br/>
                                <strong>Date:</strong> <span t-field="o.inspection_date" t-options='{"widget": "date"}'/><br/>
                            </div>
                        </div>

                        <h4>Quality Checks</h4>
                        <table class="table table-bordered mb-4">
                            <thead>
                                <tr>
                                    <th>Check Name</th>
                                    <th class="text-center">Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Stitching Check</td>
                                    <td class="text-center">
                                        <t t-if="o.stitching_check">
                                            <span style="color: green; font-weight: bold;">Pass</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: red; font-weight: bold;">Fail</span>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Measurement Check</td>
                                    <td class="text-center">
                                        <t t-if="o.measurement_check">
                                            <span style="color: green; font-weight: bold;">Pass</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: red; font-weight: bold;">Fail</span>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Finishing Check</td>
                                    <td class="text-center">
                                        <t t-if="o.finishing_check">
                                            <span style="color: green; font-weight: bold;">Pass</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: red; font-weight: bold;">Fail</span>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Defect Count</td>
                                    <td class="text-center">
                                        <span t-field="o.defect_count"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.status == 'fail'">
                            <div class="card mb-4 border-danger">
                                <div class="card-header bg-danger text-white">
                                    <strong>Reject Details</strong>
                                </div>
                                <div class="card-body">
                                    <strong>Reject Reason:</strong> <span t-field="o.reject_reason"/><br/>
                                </div>
                            </div>
                        </t>

                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <strong>Remarks</strong>
                            </div>
                            <div class="card-body">
                                <span t-esc="o.remarks or 'No remarks recorded.'"/>
                            </div>
                        </div>

                        <!-- Final Result Banner -->
                        <div class="text-center p-3 mb-4 rounded" t-attf-style="background-color: #{'#d4edda' if o.status == 'pass' else '#f8d7da'}; border: 1px solid #{'#c3e6cb' if o.status == 'pass' else '#f5c6cb'};">
                            <h3 t-attf-style="color: #{'#155724' if o.status == 'pass' else '#721c24'}; font-weight: bold; margin: 0;">
                                FINAL RESULT: <span t-esc="o.status.upper()"/>
                            </h3>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
